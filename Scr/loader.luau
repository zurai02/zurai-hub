-- ══════════════════════════════════════════════════════════════
local _SEED = mrnd(1, 0x7FFFFFFF)

-- xorshift32: fast, good avalanche, no stdlib calls in hot path
local function xs32(s: number): (number, number)
	s = b32x(s, b32l(s, 13))
	s = b32x(s, b32r(s, 17))
	s = b32x(s, b32l(s,  5))
	return b32a(s, 0xFF), s   -- returns (byte, new_state)
end

-- 32-byte key schedule derived from seed
local KS = tcr(32)
do
	local st = _SEED
	for i = 1, 32 do
		local v; v, st = xs32(st)
		KS[i] = v
	end
end
tfr(KS)

-- RC4-style S-box (256 entries, seeded from KS)
local SB  = tcr(256)   -- encrypt S-box
local ISB = tcr(256)   -- decrypt inverse
do
	for i = 0, 255 do SB[i] = i end
	local j = 0
	for i = 0, 255 do
		j = b32a(j + SB[i] + KS[(i % 32) + 1], 0xFF)
		SB[i], SB[j] = SB[j], SB[i]
	end
	for i = 0, 255 do ISB[SB[i]] = i end
end

-- Stream-cipher encrypt:  c = ISB[b XOR ks_byte XOR KS_round]
-- Symmetric: apply _xe twice does NOT decrypt; use _xd for decrypt
local function _xe(s: string): string
	local n = slen(s)
	local b = tcr(n)
	local st = _SEED
	for i = 1, n do
		local ks; ks, st = xs32(st)
		local c = sbyte(s, i)
		c = SB[b32a(c, 0xFF)]
		c = b32x(c, ks)
		c = b32x(c, KS[(i % 32) + 1])
		b[i] = schar(b32a(c, 0xFF))
	end
	return tcat(b)
end

local function _xd(s: string): string
	local n = slen(s)
	local b = tcr(n)
	local st = _SEED
	for i = 1, n do
		local ks; ks, st = xs32(st)
		local c = sbyte(s, i)
		c = b32x(c, KS[(i % 32) + 1])
		c = b32x(c, ks)
		c = ISB[b32a(c, 0xFF)]
		b[i] = schar(b32a(c, 0xFF))
	end
	return tcat(b)
end

