		ImageTransparency=1,ZIndex=3},Base) :: ImageLabel

	local Glow=mk("ImageLabel",{
		Size=U2(0,300,0,300),AnchorPoint=V2(0.5,0.5),Position=U2(0.5,0,0.5,0),
		BackgroundTransparency=1,Image="rbxassetid://5028857472",
		ImageColor3=Color3.fromRGB(88,101,242),ImageTransparency=1,ZIndex=9},Base) :: ImageLabel

	local Logo=mk("ImageLabel",{
		Size=U2(0,128,0,128),AnchorPoint=V2(0.5,0.5),Position=U2(0.5,0,0.5,0),
		BackgroundTransparency=1,Image=AVA,ImageTransparency=1,ZIndex=10},Base) :: ImageLabel

	local PC: RBXScriptConnection? = nil

	local function kill()
		if PC then PC:Disconnect();PC=nil end
		if G and G.Parent then G:Destroy() end
	end

	local function pulse()
		local t=0
		PC=S.rs.Heartbeat:Connect(function(dt)
			t+=dt
			local s=msin(t*2.2)
			local sz=128+s*4
			Glow.ImageTransparency=0.42+s*0.28
			Logo.Size=U2(0,sz,0,sz)
			Logo.Position=U2(0.5,-sz/2,0.5,-sz/2)
		end)
	end

	local function destroyFast()
		if not _LA then return end;_LA=false
		if PC then PC:Disconnect();PC=nil end
		local fi=TweenInfo.new(0.28,ECub,EI)
		tw(Logo,0.28,ECub,EI,{ImageTransparency=1,Size=U2(0,70,0,70),Position=U2(0.5,-35,0.5,-35)})
		tw(Glow,0.28,ECub,EI,{ImageTransparency=1})
		tw(Img, 0.42,ESin,EI,{ImageTransparency=1})
		tw(Grad,0.42,ESin,EI,{ImageTransparency=1})
		tw(Base,0.48,ESin,EI,{BackgroundTransparency=1})
		tdelay(0.52,kill)
	end

	local function destroyNorm()
		if not _LA then return end;_LA=false
		if PC then PC:Disconnect();PC=nil end
		tw(Logo,0.3,ECub,EI,{ImageTransparency=1})
		tw(Glow,0.3,ECub,EI,{ImageTransparency=1})
		tdelay(2.0,function()
			tw(Img, 0.65,ESin,EI,{ImageTransparency=1})
			tw(Grad,0.65,ESin,EI,{ImageTransparency=1})
			tw(Base,0.72,ESin,EI,{BackgroundTransparency=1})
			tdelay(0.75,kill)
		end)
	end

	_DL = destroyFast

	-- entrance animations
	tw(Base,0.06,ESin,EO,{BackgroundTransparency=0})
	tw(Img, 0.80,ESin,EO,{ImageTransparency=0.10})
	tw(Grad,0.80,ESin,EO,{ImageTransparency=0.0})
	tdelay(0.38,function()
		tw(Logo,0.55,EBck,EO,{ImageTransparency=0})
		tw(Glow,0.55,ESin,EO,{ImageTransparency=0.48})
		tdelay(0.48,pulse)
	end)

	return setmt({},{__index={destroy=destroyNorm,destroyFast=destroyFast}}) :: any
end


-- ══════════════════════════════════════════════════════════════
--  BOOTSTRAP
-- ══════════════════════════════════════════════════════════════
loadCFG()
checkEnv()

local ld = mkLoader()

inf("BOOT",sfmt("v%s build=%s seed=%X | place=%s job=%s | %s | up=%s",
	_VER,_BLD,_SEED,_PID,_JID,_pi(),_el()))
inf("URL", sfmt("RAW=%s BASE=%s",RAW,BASE))
logPlayers()

-- parallel-fetch game script + anti-afk together
local bt = fetchB({_PID,_GID,"anti-afk"})
local gs = bt[_PID] or bt[_GID] or resolve()

vmExec(gs,"game",function()
	-- destroy loader immediately after game script finishes executing
	tdelay(0.08,function() if _DL then _DL() end end)
end)

vmExec(bt["anti-afk"] or fetchP("Scr/games/anti-afk"),"anti-afk")

log("BOOT","boot complete in ".._el())

-- fallback loader destroy if game script never called onDone
tdelay(1.5,function() if _LA and ld then ld.destroy() end end)

saveCFG()

-- player tracking
S.plr.PlayerAdded:Connect(function(p)
	inf("JOIN",sfmt("@%s (%s) uid=%s age=%dd",p.Name,p.DisplayName,tostring(p.UserId),p.AccountAge))
end)
S.plr.PlayerRemoving:Connect(function(p)
	inf("LEAVE",sfmt("@%s uid=%s",p.Name,tostring(p.UserId)))
end)
_g.Close:Connect(function()
	inf("EXIT","session ended after ".._el())
	saveCFG()
end)

return tfr({
	_VERSION      = _VER,
	_BUILD        = _BLD,
	_CHAN         = _CHAN,
	_SEED         = _SEED,
	RAW           = RAW,
	BASE          = BASE,
	C             = C,
	xd            = _xd,
	xe            = _xe,
	saveCFG       = saveCFG,
	loadCFG       = loadCFG,
	fetch         = fetch,
	fetchP        = fetchP,
	fetchB        = fetchB,
	vmExec        = vmExec,
	get           = get,
	log           = log,
	err           = err,
	inf           = inf,
	dbg           = dbg,
	destroyLoader = function() if _DL then _DL() end end,
	gitPath       = function(path:string) return RAW..path end,
	elapsed       = _el,
})
