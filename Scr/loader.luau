local function _xe(s:string):string
	local n=_len(s)
	local b=_tcreate(n)
	for i=1,n do
		local c=_byte(s,i)
		c=_b32x(c,K1)
		c=_b32x(c,_b32a(K2,0x7F))
		c=_b32x(c,_b32a(_b32r(_b32o(K3,_b32l(K4,2)),((i-1)%8)),0xFF))
		b[i]=_char(_b32a(c,0xFF))
	end
	return _tconcat(b)
end

local function _xd(s:string):string return _xe(s)end

