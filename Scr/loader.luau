local function xs32(s: number): (number, number)
	s = b32x(s, b32l(s, 13))
	s = b32x(s, b32r(s, 17))
	s = b32x(s, b32l(s,  5))
	return b32a(s, 0xFF), s
end

local KS = tcr(32)
do
	local st = _SEED
	for i = 1, 32 do
		local v; v, st = xs32(st)
		KS[i] = v
	end
end
tfr(KS)

local SB  = tcr(256)
local ISB = tcr(256)
do
	for i = 0, 255 do SB[i] = i end
	local j = 0
	for i = 0, 255 do
		j = b32a(j + SB[i] + KS[(i % 32) + 1], 0xFF)
		SB[i], SB[j] = SB[j], SB[i]
	end
	for i = 0, 255 do ISB[SB[i]] = i end
end

local function _xe(s: string): string
	local n = slen(s)
	local b = tcr(n)
	local st = _SEED
	for i = 1, n do
		local ks; ks, st = xs32(st)
		local c = sbyte(s, i)
		c = SB[b32a(c, 0xFF)]
		c = b32x(c, ks)
		c = b32x(c, KS[(i % 32) + 1])
		b[i] = schar(b32a(c, 0xFF))
	end
	return tcat(b)
end

local function _xd(s: string): string
	local n = slen(s)
	local b = tcr(n)
	local st = _SEED
	for i = 1, n do
		local ks; ks, st = xs32(st)
		local c = sbyte(s, i)
		c = b32x(c, KS[(i % 32) + 1])
		c = b32x(c, ks)
		c = ISB[b32a(c, 0xFF)]
		b[i] = schar(b32a(c, 0xFF))
	end
	return tcat(b)
end

