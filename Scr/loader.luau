local function _mk(cls:string,p:{[string]:any},par:Instance?):Instance
	local o=_newI(cls)
	if not p.Name then o.Name=_rn()end
	for k,v in _pairs(p)do(o::any)[k]=v end
	if par then o.Parent=par end
	return o
end

