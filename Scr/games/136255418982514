local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

local InstantCollect = false
local AutoMoneyCollect = false

local function getRoot(char)
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") 
        or char:FindFirstChild("Torso") 
        or char:FindFirstChild("UpperTorso")
end

local function getPlayerPlot()
    local plots = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Plots")
    if not plots then return nil end

    for _, plot in ipairs(plots:GetChildren()) do
        local owner = plot:FindFirstChild("Owner") or plot:GetAttribute("Owner")
        if owner then
            if typeof(owner) == "Instance" and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then
                return plot
            elseif tostring(owner) == LocalPlayer.Name or tostring(owner) == tostring(LocalPlayer.UserId) then
                return plot
            end
        end
    end
    return nil
end

local function setupPrompt(prompt)
    if not prompt:IsA("ProximityPrompt") then return end

    if InstantCollect then
        prompt.HoldDuration = 0
    end

    prompt.PromptShown:Connect(function()
        if InstantCollect and fireprompt then
            fireprompt(prompt)
        end
    end)

    prompt.Triggered:Connect(function(plr)
        if plr == LocalPlayer and InstantCollect then
            local character = plr.Character
            if character then
                character:MoveTo(Vector3.new(-285, 51, -50))
            end
        end
    end)
end

local itemSpawners = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("ItemSpawners")
if itemSpawners then
    for _, descendant in ipairs(itemSpawners:GetDescendants()) do
        setupPrompt(descendant)
    end
    itemSpawners.DescendantAdded:Connect(setupPrompt)
end

task.spawn(function()
    while task.wait(0.25) do
        if AutoMoneyCollect then
            local plot = getPlayerPlot()
            local char = LocalPlayer.Character
            local root = getRoot(char)

            if plot and root then
                for _, descendant in ipairs(plot:GetDescendants()) do
                    if descendant:IsA("TouchTransmitter") and descendant.Parent then
                        pcall(function()
                            firetouchinterest(descendant.Parent, root, 0)
                            task.wait(0.01)
                            firetouchinterest(descendant.Parent, root, 1)
                        end)
                    end
                end
            end
        end
    end
end)

return function(section)
    local elements = loadstring(game:HttpGet(getgitpath("src") .. "UI.lua"))()

    elements:Toggle("Instant Collect", section, false, function(bool)
        InstantCollect = bool
        
        if itemSpawners then
            for _, descendant in ipairs(itemSpawners:GetDescendants()) do
                if descendant:IsA("ProximityPrompt") then
                    descendant.HoldDuration = bool and 0 or 1
                end
            end
        end
    end)

    elements:Toggle("Auto Collect Money", section, false, function(bool)
        AutoMoneyCollect = bool
    end)
end
