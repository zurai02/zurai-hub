local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local userId = localPlayer.UserId


local Window = Rayfield:CreateWindow({
   Name = "Zurai Hub | Toilet Tower Defense",
    LoadingSubtitle = "Welcome " .. userId,
   ConfigurationSaving = { Enabled = true, FolderName = "ZuraiHub_TTD", FileName = "Config" },
})

getgenv().AutoEverything = false
getgenv().AutoPlace = false
getgenv().AutoUpgrade = false
getgenv().AutoSkip = false
getgenv().AutoReplay = false
getgenv().AutoSell = false
getgenv().AutoLobbyJoin = false
getgenv().AntiLeave = false
getgenv().SelectedMap = "Toilet City"
getgenv().SelectedDifficulty = "Easy"
getgenv().SpeedHack = false
getgenv().WalkSpeedValue = 50
getgenv().JumpPowerHack = false
getgenv().JumpPowerValue = 50
getgenv().Noclip = false
getgenv().InfiniteJump = false
getgenv().FpsUnlocker = false
getgenv().FullBright = false
getgenv().AntiAfk = true

local MainTab = Window:CreateTab({ Name = "Automation", Icon = "play" })
local LobbyTab = Window:CreateTab({ Name = "Lobby Controls", Icon = "home" })
local PlayerTab = Window:CreateTab({ Name = "Player Mods", Icon = "user" })
local VisualsTab = Window:CreateTab({ Name = "Visual Settings", Icon = "eye" })
local SettingsTab = Window:CreateTab({ Name = "Hub Settings", Icon = "settings" })

local function getEquippedUnits()
    local units = {}
    local equippedFolder = game.Players.LocalPlayer:FindFirstChild("EquippedUnits") or game.Players.LocalPlayer:FindFirstChild("Equipped")
    if equippedFolder then
        for _, unit in pairs(equippedFolder:GetChildren()) do
            table.insert(units, unit.Name)
        end
    end
    if #units == 0 then
        local inventory = game.Players.LocalPlayer:FindFirstChild("Inventory")
        if inventory then
            for _, unit in pairs(inventory:GetChildren()) do
                if unit:FindFirstChild("Equipped") and unit.Equipped.Value == true then
                    table.insert(units, unit.Name)
                end
            end
        end
    end
    if #units == 0 then
        table.insert(units, "Titan Speaker Man")
    end
    return units
end

local function getDynamicPlacementCoordinates()
    local localPlayer = game.Players.LocalPlayer
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local pos = localPlayer.Character.HumanoidRootPart.Position
        local offsetX = math.random(-8, 8)
        local offsetZ = math.random(-8, 8)
        return Vector3.new(pos.X + offsetX, pos.Y, pos.Z + offsetZ)
    end
    local pathFolder = workspace:FindFirstChild("Path") or workspace:FindFirstChild("Road") or workspace:FindFirstChild("Track")
    if pathFolder then
        local firstPart = pathFolder:FindFirstChildWhichIsA("BasePart", true)
        if firstPart then
            return firstPart.Position + Vector3.new(12, 0, 12)
        end
    end
    return Vector3.new(math.random(-50, 50), 0, math.random(-50, 50))
end

task.spawn(function()
    while task.yield(1) do
        if getgenv().AutoEverything then
            getgenv().AutoPlace = true
            getgenv().AutoUpgrade = true
            getgenv().AutoSkip = true
            getgenv().AutoReplay = true
        end
    end
end)

task.spawn(function()
    while task.yield(0.4) do
        if getgenv().AutoSkip then
            local skipRemote = game:GetService("ReplicatedStorage"):FindFirstChild("SkipWave", true) 
                or game:GetService("ReplicatedStorage"):FindFirstChild("Skip", true)
                or game:GetService("ReplicatedStorage"):FindFirstChild("SkipVote", true)
            if skipRemote then
                if skipRemote:IsA("RemoteEvent") then
                    skipRemote:FireServer()
                elseif skipRemote:IsA("RemoteFunction") then
                    skipRemote:InvokeServer()
                end
            end
        end
    end
end)

task.spawn(function()
    while task.yield(2.2) do
        if getgenv().AutoPlace then
            local placementRemote = game:GetService("ReplicatedStorage"):FindFirstChild("PlaceUnit", true) 
                or game:GetService("ReplicatedStorage"):FindFirstChild("SpawnUnit", true)
            if placementRemote then
                local equipped = getEquippedUnits()
                local unitToPlace = equipped[math.random(1, #equipped)]
                local targetPos = getDynamicPlacementCoordinates()
                if placementRemote:IsA("RemoteFunction") then
                    placementRemote:InvokeServer(unitToPlace, targetPos)
                elseif placementRemote:IsA("RemoteEvent") then
                    placementRemote:FireServer(unitToPlace, targetPos)
                end
            end
        end
    end
end)

task.spawn(function()
    while task.yield(2.8) do
        if getgenv().AutoUpgrade then
            local upgradeRemote = game:GetService("ReplicatedStorage"):FindFirstChild("UpgradeUnit", true) 
                or game:GetService("ReplicatedStorage"):FindFirstChild("Upgrade", true)
            if upgradeRemote then
                for _, unit in pairs(workspace:GetChildren()) do
                    local isOwned = false
                    if unit:FindFirstChild("Owner") and unit.Owner.Value == game.Players.LocalPlayer then
                        isOwned = true
                    elseif unit:GetAttribute("Owner") == game.Players.LocalPlayer.UserId then
                        isOwned = true
                    end
                    if isOwned then
                        if upgradeRemote:IsA("RemoteFunction") then
                            upgradeRemote:InvokeServer(unit)
                        elseif upgradeRemote:IsA("RemoteEvent") then
                            upgradeRemote:FireServer(unit)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.yield(3.5) do
        if getgenv().AutoReplay then
            local playerGui = game.Players.LocalPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                for _, gui in pairs(playerGui:GetChildren()) do
                    if string.find(string.lower(gui.Name), "end") or string.find(string.lower(gui.Name), "match") or string.find(string.lower(gui.Name), "victory") or string.find(string.lower(gui.Name), "gameover") or string.find(string.lower(gui.Name), "result") then
                        if gui.Enabled or (gui:IsA("ScreenGui") and gui.Enabled == true) then
                            local btn = gui:FindFirstChild("Replay", true) 
                                or gui:FindFirstChild("Retry", true) 
                                or gui:FindFirstChild("Restart", true) 
                                or gui:FindFirstChild("PlayAgain", true)
                            if btn and btn:IsA("TextButton") and btn.Visible then
                                local virtualInput = game:GetService("VirtualInputManager")
                                local x = btn.AbsolutePosition.X + (btn.AbsoluteSize.X / 2)
                                local y = btn.AbsolutePosition.Y + (btn.AbsoluteSize.Y / 2)
                                virtualInput:SendMouseButtonEvent(x, y, 0, true, game, 1)
                                task.yield(0.1)
                                virtualInput:SendMouseButtonEvent(x, y, 0, false, game, 1)
                            end
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.yield(4) do
        if getgenv().AutoSell then
            local sellRemote = game:GetService("ReplicatedStorage"):FindFirstChild("SellUnit", true) or game:GetService("ReplicatedStorage"):FindFirstChild("Sell", true)
            if sellRemote then
                for _, unit in pairs(workspace:GetChildren()) do
                    if unit:FindFirstChild("Owner") and unit.Owner.Value == game.Players.LocalPlayer then
                        if sellRemote:IsA("RemoteFunction") then
                            sellRemote:InvokeServer(unit)
                        elseif sellRemote:IsA("RemoteEvent") then
                            sellRemote:FireServer(unit)
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.yield(5) do
        if getgenv().AutoLobbyJoin then
            local elevators = workspace:FindFirstChild("Elevators") or workspace:FindFirstChild("LobbyElevators") or workspace:FindFirstChild("Lifts")
            if elevators then
                for _, elevator in pairs(elevators:GetChildren()) do
                    local mapName = elevator:FindFirstChild("MapName") or elevator:FindFirstChild("Map")
                    if mapName and string.find(string.lower(mapName.Value), string.lower(getgenv().SelectedMap)) then
                        local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        local part = elevator:FindFirstChildWhichIsA("BasePart", true)
                        if root and part then
                            root.CFrame = part.CFrame
                            break
                        end
                    end
                end
            end
        end
    end
end)

task.spawn(function()
    while task.yield(1) do
        if getgenv().SpeedHack and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = getgenv().WalkSpeedValue
        end
        if getgenv().JumpPowerHack and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = getgenv().JumpPowerValue
            game.Players.LocalPlayer.Character.Humanoid.UseJumpPower = true
        end
    end
end)

game:GetService("RunService").Stepped:Connect(function()
if getgenv().Noclip and game.Players.LocalPlayer.Character then
for _, part in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
if part:IsA("BasePart") then
part.CanCollide = false
end
end
end
end)
game:GetService("UserInputService").JumpRequest:Connect(function()
if getgenv().InfiniteJump and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid") then
game.Players.LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid"):ChangeState("Jumping")
end
end)
if getgenv().AntiAfk then
local vu = game:GetService("VirtualUser")
game.Players.LocalPlayer.Idled:Connect(function()
vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
task.yield(1)
vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
